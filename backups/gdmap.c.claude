    {"IMG",4},{"PI1",4},{"PI2",4},{"PI3",4},{"NEO",4},{"TNY",4},{"DEG",4},
    {"GIF",4},{"JPG",4},{"JPEG",4},{"PNG",4},{"BMP",4},{"TIF",4},{"TGA",4},
    {"IFF",4},{"PCX",4},{"PC1",4},{"PC2",4},{"PC3",4},
    /* 5 audio */
    {"MOD",5},{"MP3",5},{"MP2",5},{"WAV",5},{"AVR",5},{"SND",5},{"SNDH",5},
    {"YM",5},{"OGG",5},{"MID",5},{"AIF",5},{"AIFF",5},{"FLAC",5},

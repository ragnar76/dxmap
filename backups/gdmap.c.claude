/*
 * X-Map  -  graphical disk map (treemap) for Atari GEM, built on WinDom
 *
 *   - runs completely inside a resizable GEM window with its own menu
 *   - TOS 1.x ... 4.x, EmuTOS, FreeMiNT/MagiC, FireBee, Milan, Hades
 *   - with more than 16 colours the tiles are drawn as shaded "cushions"
 *
 * Menu:   X-Map: Info
 *         Datei: Oeffnen... / Einstellungen... / Beenden
 *         Ansicht: Farbmodus (ein/aus) / Aktualisieren
 *
 * Keys:   O open   R refresh   C colour mode   G folder borders
 *         Return / double click = zoom in, Backspace = zoom out
 *         Esc = abort scan   H = help   Q / Ctrl-Q = quit
 *
 * Build:  see Makefile (m68k-atari-mint-gcc, WinDom, gemlib)
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <mint/osbind.h>
#include <mint/mintbind.h>
#include <mint/ostruct.h>
#include <windom.h>              /* defines the macros app, evnt, wglb: include last */

#ifndef __CDECL
# define __CDECL
#endif

long _stksize = 32768L;          /* mintlib: stack size for recursion */

/* Atari ST character set (the menu and alerts are shown with the system font) */
#define AE  "\204"               /* ae */
#define OE  "\224"               /* oe */
#define UE  "\201"               /* ue */
#define OEC "\231"               /* Oe */

#define APPNAME     "X-Map"

typedef unsigned long long u64;
typedef unsigned long      u32;

#define NHUES       12           /* colour groups (file types)         */
#define MAXSHADE    16           /* shades per group (cushion steps)   */
#define FIRST_PEN   16           /* first VDI pen we may redefine      */
#define MAXCELLS    60000L       /* max. number of drawn tiles         */
#define PATHLEN     1024         /* max. path length (long file names) */

typedef struct node {
    struct node *parent, *child, *next, *todo;
    char *name;
    u64 size;                    /* file size / sum of directory       */
    unsigned char isdir, hue;
} Node;

typedef struct { short x, y, w, h; Node *n; } Cell;

static WINDOW *mainwin;
static short vh, cw, ch, bw, bh;
static Node *root, *view_root, *sel, *todo;
static int   scanning, endprog, oom, cells_full, want_open;
static u32   n_files, n_dirs, scan_steps;
static short scan_mask = 0x17;           /* ro + hidden + system + dir */
static int   show_hidden = 1;

static Cell *cells;
static long  ncells, capcells;
static GRECT work;

static short planes, nshade;
static int   cushion_ok, cushions_on, show_dirs = 1;
static short saved_pal[NHUES * MAXSHADE][3];
static short pal_rgb[NHUES * MAXSHADE][3];
static int   pal_saved;

static char  title[PATHLEN + 64], scan_root[PATHLEN], status_msg[PATHLEN];
static char  info_buf[2][PATHLEN + 64];      /* alternating: forces info line redraw */
static int   info_sel, busy, use_mint;
static short prev_mb;


/* menu object indices */
#define M_INFO     8
#define M_OPEN     10
#define M_PREF     12
#define M_QUIT     14
#define M_COLOR    16
#define M_REFRESH  17
#define M_NOBJ     18

/* ------------------------------------------------------------------ */
/* helpers, tree, scanner, layout                                      */
/* ------------------------------------------------------------------ */
static int grect_isect(const GRECT *a, GRECT *b)   /* b = a AND b */
{
    short x1 = (a->g_x > b->g_x) ? a->g_x : b->g_x;
    short y1 = (a->g_y > b->g_y) ? a->g_y : b->g_y;
    short x2 = (a->g_x + a->g_w < b->g_x + b->g_w) ? a->g_x + a->g_w : b->g_x + b->g_w;
    short y2 = (a->g_y + a->g_h < b->g_y + b->g_h) ? a->g_y + a->g_h : b->g_y + b->g_h;
    if (x2 > x1 && y2 > y1) {
        b->g_x = x1; b->g_y = y1; b->g_w = x2 - x1; b->g_h = y2 - y1;
        return 1;
    }
    return 0;
}

static void fmt_size(u64 s, char *buf)
{
    static const char *unit[] = { "Bytes", "KB", "MB", "GB", "TB" };
    u64 div = 1;
    int u = 0;
    while (u < 4 && s >= div * 1024) { div *= 1024; u++; }
    if (u == 0)
        sprintf(buf, "%lu Bytes", (unsigned long)s);
    else
        sprintf(buf, "%lu.%lu %s", (unsigned long)(s / div),
                (unsigned long)(((s % div) * 10) / div), unit[u]);
}

static void build_path(const Node *n, char *buf, int max)
{
    const Node *stack[96];
    int d = 0, i;
    buf[0] = 0;
    while (n && d < 96) { stack[d++] = n; n = n->parent; }
    for (i = d - 1; i >= 0; i--) {
        if (i != d - 1 && (int)strlen(buf) + 2 < max) strcat(buf, "\\");
        strncat(buf, stack[i]->name, max - (int)strlen(buf) - 1);
    }
}


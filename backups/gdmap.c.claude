    {"TXT",7},{"DOC",7},{"ASC",7},{"RTF",7},{"HTM",7},{"HTML",7},{"PDF",7},
    {"HYP",7},{"1ST",7},{"MD",7},{"TEX",7},
    /* 8 source code */
    {"C",8},{"H",8},{"S",8},{"ASM",8},{"CPP",8},{"PAS",8},{"BAS",8},
